      "targets": [
        {
          "refId": "A",
          "expr": "1 - sum by (sensor) (rate(botgraph_host_score_bucket{sensor=~\"$sensor\",le=\"0.9\"}[15m])) / sum by (sensor) (rate(botgraph_host_score_count{sensor=~\"$sensor\"}[15m]))",
